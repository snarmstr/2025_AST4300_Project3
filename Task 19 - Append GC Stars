## Normalize Cluster Names Function ##

def normalize_cluster_name(name: str) -> str:
    if not isinstance(name, str):
        return name
    name = name.replace("b'", "").replace("'", "").strip()
    parts = name.split()
    if name.upper().startswith("NGC") and len(parts) == 1:
        num = name[3:]
        if num.isdigit():
            return f"NGC {int(num)}"
    if len(parts) == 2 and parts[0].upper() == "NGC" and parts[1].isdigit():
        return f"{parts[0]} {int(parts[1])}"
    return name


## Read Files and Convert to Pandas Dataframe ##

# astras
astra_tab = Table.read(astra_path, hdu=2)
one_d_cols = [name for name in astra_tab.colnames if astra_tab[name].ndim == 1]
astra_df = astra_tab[one_d_cols].to_pandas()

# gc members
members_tab = Table.read(gc_members_path, hdu=1)
members_one_d = [c for c in members_tab.colnames if members_tab[c].ndim == 1]
members_df = members_tab[members_one_d].to_pandas()
members_df = members_df.rename(columns={"APOGEE_ID": "sdss4_apogee_id"})

# gc parameters
params_tab = Table.read(gc_params_path, hdu=1)
params_one_d = [c for c in params_tab.colnames if params_tab[c].ndim == 1]
params_df = params_tab[params_one_d].to_pandas()
params_df = params_df.rename(columns={"GC_name": "GC_NAME"})
params_df["GC_NAME"] = params_df["GC_NAME"].apply(normalize_cluster_name)

# read mf table and account for title rows
mf_df = pd.read_csv(
    mf_path,
    sep="\t",
    skiprows=3)

# convert relative ages to absolute ages on the Ying et al. scale
rel_age_column = "D07_ZW"
mf_df["rel_age"] = (
    mf_df[rel_age_column]
    .astype(str)
    .str.split()
    .str[0]
    .astype(float))
mf_df["GC_AGE_GYR_YING23"] = 13.5 * mf_df["rel_age"]

# normalize cluster names and drop duplicates
mf_df["GC_NAME"] = mf_df["Name"].apply(normalize_cluster_name)
mf_age_small = mf_df[["GC_NAME", "GC_AGE_GYR_YING23"]].drop_duplicates()


## Merge Astra and GC Files ##

# astra + gc
astra_plus_members = astra_df.merge(
    members_df,
    on="sdss4_apogee_id",
    how="left")
astra_with_gc = astra_plus_members.merge(
    params_df,
    on="GC_NAME",
    how="left")
astra_with_gc["GC_NAME"] = (
    astra_with_gc["GC_NAME"]
    .astype(str)
    .str.replace("b'", "", regex=False)
    .str.replace("'", "", regex=False)
    .str.strip())

# normalize names just in case
astra_with_gc["GC_NAME"] = astra_with_gc["GC_NAME"].apply(normalize_cluster_name)


## Merge ASTRA/GC and MF File ##

# astra + gc
astra_with_gc_age = astra_with_gc.merge(
